PORT=3001
DB_PATH=arigreet.sqlite
PUBLIC_URL=https://your-domain.example
NEARBY_METRES=30
VERY_CLOSE_METRES=10
FLIGHTAWARE_API_KEY=
FLIGHT_POLL_SECONDS=300
FLIGHT_ALERT_MINUTES=20
VAPID_SUBJECT=mailto:support@your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Arigreet <support@your-domain.example>
# Close a Greet when only one person confirmed the meeting, after this many minutes
CONFIRM_TIMEOUT_MINUTES=10
# Map tiles for production (free MapTiler key at maptiler.com). Or set MAP_TILES_URL + MAP_ATTRIBUTION.
MAPTILER_KEY=
# Shown on /privacy and /terms
LEGAL_NAME=
LEGAL_ADDRESS=
CONTACT_EMAIL=
# Finished Greets are deleted after this many days
RETENTION_DAYS=30
# Continue with Google: the "Web application" OAuth client ID from Google Cloud
GOOGLE_WEB_CLIENT_ID=
# Later, for iPhone: extra client IDs, comma-separated
GOOGLE_EXTRA_CLIENT_IDS=
# Android alerts: the whole Firebase service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT=
# Pickup links open the Android app: SHA-256 fingerprint(s) from Play Console → App signing
ANDROID_CERT_SHA256=
