{
  "appId": "com.arigreet.app",
  "appName": "Arigreet",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "cleartext": false
  },
  "android": {
    "backgroundColor": "#ffffff",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": true,
        "twitter": false
      },
      "logLevel": 1
    },
    "CapacitorHttp": {
      "enabled": false
    }
  }
}